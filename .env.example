# Smart Investment Decision Fusion System – environment variables
# Copy this file to .env and fill in any keys you have.
# All keys are optional; the system works with just the free sources.

# ── Stock data (optional) ───────────────────────────────────────────────────
# Alpha Vantage premium data source. Falls back to yfinance when absent.
# Get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ── News sources (optional) ─────────────────────────────────────────────────
# Google News RSS is always active and requires NO key.
#
# NewsAPI.org – adds a second news source (free tier: 100 req/day).
# Get a free key at https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here
